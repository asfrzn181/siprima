rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function login() { return request.auth != null; }
    function me() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data; }
    function aktif() { return login() && me().get('aktif', false) == true; }
    function role() { return me().get('role', ''); }
    function bidang() { return me().get('bidang', ''); }
    function admin() { return aktif() && role() == 'admin'; }
    function verifikator() { return aktif() && role() in ['admin', 'pimpinan']; }
    function operator() { return aktif() && role() in ['admin', 'bidang']; }
    function pimpinanAtauAdmin() { return verifikator(); }
    function boleh(d) { return d.get('sifat', 'biasa') == 'biasa' || verifikator() || bidang() in d.get('aksesBidang', []); }
    function roleValid(d) { return d.keys().hasOnly(['uid','email','nama','role','bidang','aktif']) && d.uid is string && d.email is string && d.nama is string && d.role in ['admin','pimpinan','bidang'] && d.bidang is string && d.aktif is bool; }
    function suratMasukValid(d) {
      return d.keys().hasOnly(['noAgenda','tglTerima','tglSurat','noSurat','asal','hal','isiRingkas','sifat','fileId','fileUrl','status','dibuatOleh','dibuatPada','aksesBidang','disposisi','tindakLanjut','diubahPada'])
        && d.noAgenda is string && d.tglTerima is timestamp && d.tglSurat is timestamp && d.noSurat is string && d.noSurat.size() > 0 && d.noSurat.size() <= 120
        && d.asal is string && d.asal.size() > 0 && d.asal.size() <= 160 && d.hal is string && d.hal.size() > 0 && d.hal.size() <= 200
        && d.isiRingkas is string && d.isiRingkas.size() > 0 && d.isiRingkas.size() <= 2000 && d.sifat in ['biasa','rahasia'] && d.fileId is string
        && d.get('fileUrl','') is string && d.status in ['Baru','Didisposisikan','Selesai'] && d.aksesBidang is list && d.dibuatOleh is map && d.dibuatPada is timestamp
        && (d.sifat == 'biasa' || d.aksesBidang.size() > 0);
    }
    function suratKeluarValid(d) {
      return d.keys().hasOnly(['noSurat','jenisId','tglSurat','tujuan','hal','isiRingkas','sifat','tandaTangan','fileId','fileUrl','bidangPembuat','dibuatOleh','status','alasanBatal','aksesBidang','dibuatPada','diubahPada','letterNumberId','letterRowVersion','dikirimKeLuar'])
        && d.noSurat is string && d.noSurat.size() > 0 && d.noSurat.size() <= 160 && d.jenisId is string && d.tglSurat is timestamp
        && d.tujuan is string && d.tujuan.size() > 0 && d.tujuan.size() <= 200 && d.hal is string && d.hal.size() > 0 && d.hal.size() <= 200
        && d.isiRingkas is string && d.isiRingkas.size() > 0 && d.isiRingkas.size() <= 2000 && d.sifat in ['biasa','rahasia']
        && d.get('tandaTangan', 'BASAH') in ['TTE','BASAH'] && d.fileId is string && d.get('fileUrl','') is string && d.bidangPembuat is string && d.bidangPembuat.size() > 0
        && d.dibuatOleh is map && d.dibuatPada is timestamp && d.status in ['Aktif','Dibatalkan'] && d.alasanBatal is string && d.aksesBidang is list
        && (d.status == 'Aktif' || d.alasanBatal.size() >= 1) && (d.sifat == 'biasa' || d.bidangPembuat in d.aksesBidang)
        && (d.get('letterNumberId', '') == '' || d.get('letterNumberId', '') is string)
        && (d.get('letterRowVersion', 1) is int) && (d.get('dikirimKeLuar', false) is bool);
    }
    function masterBidangValid(d) { return d.keys().hasOnly(['kode','nama','aktif']) && d.kode is string && d.kode.size() > 0 && d.kode.size() <= 40 && d.nama is string && d.nama.size() > 0 && d.nama.size() <= 120 && d.aktif is bool; }
    function masterNomorValid(d) { return d.keys().hasOnly(['nama','format','kode','resetTahunan','urutanPerBidang','aktif']) && d.nama is string && d.nama.size() > 0 && d.nama.size() <= 120 && d.format is string && d.format.size() > 0 && d.format.size() <= 180 && d.kode is string && d.kode.size() > 0 && d.kode.size() <= 40 && d.resetTahunan is bool && d.urutanPerBidang is bool && d.aktif is bool; }
    function settingsValid(d) { return d.keys().hasOnly(['namaDinas','appsScriptUrl','numberingScope','reservationMinutes']) && d.namaDinas is string && d.namaDinas.size() <= 180 && d.appsScriptUrl is string && d.appsScriptUrl.size() <= 500 && d.get('numberingScope','GLOBAL_PER_TAHUN') in ['GLOBAL_PER_TAHUN','PER_KLASIFIKASI'] && d.get('reservationMinutes',15) is int && d.get('reservationMinutes',15) >= 1 && d.get('reservationMinutes',15) <= 1440; }
    function letterNumberShape(d) {
      return d.keys().hasOnly(['id','seq','seq_suffix','klasifikasi','unit','bulan','bulan_romawi','tahun','scope_key','jenisId','full_number','status','letter_date','perihal','tujuan','created_by','issued_at','voided_at','voided_by','void_reason','replaced_by_id','replacement_of_id','reservation_expires_at','idempotency_key','row_version','created_at','letter_id','reused_at','reused_by','reuse_count','reuse_reason'])
        && d.id is string && d.seq is int && (d.get('seq_suffix', null) == null || d.get('seq_suffix','') is string) && d.klasifikasi is string && d.unit is string
        && d.bulan is int && d.bulan >= 1 && d.bulan <= 12 && d.bulan_romawi is string && d.tahun is int && d.scope_key is string && d.jenisId is string
        && d.full_number is string && d.full_number.size() > 0 && d.full_number.size() <= 200 && d.status in ['RESERVED','ISSUED','VOID'] && d.letter_date is timestamp
        && d.perihal is string && d.tujuan is string && d.created_by is map && d.void_reason is string && d.row_version is int && d.row_version >= 1 && d.created_at is timestamp;
    }
    function letterNumberImmutable() { return request.resource.data.id == resource.data.id && request.resource.data.seq == resource.data.seq && request.resource.data.get('seq_suffix', null) == resource.data.get('seq_suffix', null) && request.resource.data.klasifikasi == resource.data.klasifikasi && request.resource.data.unit == resource.data.unit && request.resource.data.bulan == resource.data.bulan && request.resource.data.tahun == resource.data.tahun && request.resource.data.scope_key == resource.data.scope_key && request.resource.data.jenisId == resource.data.jenisId && request.resource.data.full_number == resource.data.full_number; }

    match /users/{uid} {
      allow read: if aktif() && (admin() || uid == request.auth.uid);
      allow create: if admin() && roleValid(request.resource.data) && request.resource.data.uid == uid;
      allow update: if admin() && roleValid(request.resource.data) && request.resource.data.uid == resource.data.uid;
      allow delete: if false;
    }
    match /masterBidang/{id} { allow read: if aktif(); allow write: if admin() && masterBidangValid(request.resource.data); }
    match /masterNomor/{id} { allow read: if aktif(); allow write: if admin() && masterNomorValid(request.resource.data); }
    match /pengaturan/{id} { allow read: if aktif(); allow write: if admin() && settingsValid(request.resource.data); }
    match /suratMasuk/{id} {
      allow read: if aktif() && boleh(resource.data);
      allow create: if admin() && suratMasukValid(request.resource.data) && request.resource.data.status == 'Baru' && request.resource.data.dibuatOleh.uid == request.auth.uid;
      allow update: if aktif() && suratMasukValid(request.resource.data) && request.resource.data.noAgenda == resource.data.noAgenda && request.resource.data.dibuatOleh == resource.data.dibuatOleh && request.resource.data.dibuatPada == resource.data.dibuatPada && (pimpinanAtauAdmin() || (role() == 'bidang' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tindakLanjut','status','diubahPada'])));
      allow delete: if false;
    }
    match /suratKeluar/{id} {
      allow read: if aktif() && boleh(resource.data);
      allow create: if operator() && suratKeluarValid(request.resource.data) && (admin() || (role() == 'bidang' && request.resource.data.bidangPembuat == bidang()));
      allow update: if aktif() && suratKeluarValid(request.resource.data)
        && request.resource.data.noSurat == resource.data.noSurat
        && request.resource.data.dibuatPada == resource.data.dibuatPada
        && (
          // Admin boleh ubah apa saja yang valid
          admin() ||
          // Pimpinan hanya boleh ubah status/alasan batal + letterRowVersion
          (role() == 'pimpinan' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','alasanBatal','letterRowVersion','diubahPada'])) ||
          // Bidang pembuat boleh ubah konten + file (jenisId, bidangPembuat, noSurat tetap sama)
          (role() == 'bidang' && resource.data.bidangPembuat == bidang()
            && request.resource.data.jenisId == resource.data.jenisId
            && request.resource.data.bidangPembuat == resource.data.bidangPembuat
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tujuan','hal','tglSurat','isiRingkas','fileId','fileUrl','diubahPada','letterRowVersion']))
        );
      allow delete: if false;
    }
    match /counters/{id} {
      allow read: if aktif();
      allow create: if aktif() && request.resource.data.keys().hasOnly(['last']) && request.resource.data.last == 1;
      allow update: if aktif() && request.resource.data.keys().hasOnly(['last']) && request.resource.data.last == resource.data.last + 1;
      allow delete: if false;
    }
    match /auditLog/{id} {
      allow read: if admin();
      allow create: if aktif() && request.resource.data.keys().hasOnly(['uid','nama','aksi','koleksi','docId','sebelum','sesudah','waktu']) && request.resource.data.uid == request.auth.uid && request.resource.data.aksi is string && request.resource.data.koleksi is string && request.resource.data.docId is string && request.resource.data.waktu is timestamp;
      allow update, delete: if false;
    }

    match /letter_counters/{id} {
      allow read: if operator();
      allow create: if operator() && request.resource.data.keys().hasOnly(['tahun','scope','scope_key','last_seq','updated_at']) && request.resource.data.tahun is int && request.resource.data.scope in ['GLOBAL_PER_TAHUN','PER_KLASIFIKASI'] && request.resource.data.scope_key is string && request.resource.data.last_seq is int && request.resource.data.last_seq >= 1 && request.resource.data.updated_at is timestamp;
      allow update: if operator() && request.resource.data.keys().hasOnly(['tahun','scope','scope_key','last_seq','updated_at']) && request.resource.data.tahun == resource.data.tahun && request.resource.data.scope == resource.data.scope && request.resource.data.scope_key == resource.data.scope_key && request.resource.data.last_seq == resource.data.last_seq + 1 && request.resource.data.updated_at is timestamp;
      allow delete: if false;
    }
    match /letter_numbers/{id} {
      allow read: if aktif() && (admin() || role() == 'pimpinan' || resource.data.unit == bidang());
      allow create: if operator() && letterNumberShape(request.resource.data) && request.resource.data.status == 'RESERVED' && request.resource.data.created_by.uid == request.auth.uid;
      allow update: if aktif() && letterNumberShape(request.resource.data) && letterNumberImmutable() && (
        // ISSUED dari RESERVED: boleh operator yang buat ATAU admin mana saja
        (operator() && request.resource.data.status == 'ISSUED' && resource.data.status == 'RESERVED' && (resource.data.created_by.uid == request.auth.uid || admin()) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','letter_id','perihal','tujuan','letter_date','issued_at','row_version'])) ||
        // Edit metadata (perihal/tujuan/tanggal) oleh admin atau operator yg buat
        (admin() && request.resource.data.status == resource.data.status && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['perihal','tujuan','letter_date','row_version'])) ||
        (operator() && resource.data.created_by.uid == request.auth.uid && request.resource.data.status == resource.data.status && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['perihal','tujuan','letter_date','row_version'])) ||
        // VOID oleh verifikator (admin/pimpinan)
        (verifikator() && request.resource.data.status == 'VOID' && resource.data.status in ['RESERVED','ISSUED'] && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','voided_at','voided_by','void_reason','replaced_by_id','row_version'])) ||
        // Reuse VOID oleh admin
        (admin() && resource.data.status == 'VOID' && request.resource.data.status == 'ISSUED' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','letter_id','letter_date','perihal','tujuan','issued_at','reused_at','reused_by','reuse_count','reuse_reason','row_version']))
      );
      allow delete: if false;
    }
    match /letter_number_index/{id} {
      allow read: if operator();
      allow create: if operator() && request.resource.data.keys().hasOnly(['letter_id','full_number','created_at']) && request.resource.data.letter_id is string && request.resource.data.full_number is string && request.resource.data.created_at is timestamp;
      allow update, delete: if false;
    }
    match /letter_idempotency/{id} {
      allow read: if operator();
      allow create: if operator() && request.resource.data.keys().hasOnly(['letter_id','created_at']) && request.resource.data.letter_id is string && request.resource.data.created_at is timestamp;
      allow update, delete: if false;
    }
    match /letter_audit_log/{id} {
      allow read: if admin();
      allow create: if aktif() && request.resource.data.keys().hasOnly(['id','letter_id','action','actor','timestamp','before_json','after_json','prev_hash','hash']) && request.resource.data.id is string && request.resource.data.letter_id is string && request.resource.data.action is string && request.resource.data.actor.uid == request.auth.uid && request.resource.data.timestamp is timestamp && request.resource.data.prev_hash is string && request.resource.data.hash is string;
      allow update, delete: if false;
    }
    match /letter_audit_heads/{id} {
      allow read: if aktif();
      allow create, update: if aktif() && request.resource.data.keys().hasOnly(['last_hash','updated_at']) && request.resource.data.last_hash is string && request.resource.data.updated_at is timestamp;
      allow delete: if false;
    }
  }
}
