{
  "name": "siprima",
  "version": "3.0.0",
  "private": true,
  "description": "Agenda surat masuk dan surat keluar dengan Express.js + MySQL 8",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/migrate.js up",
    "migrate:down": "node scripts/migrate.js down",
    "seed": "node scripts/seed.js",
    "lint": "eslint src public/assets/js tests scripts",
    "format": "prettier --write \"{src,public/assets/js,tests,scripts}/**/*.js\" \"*.{js,cjs,json,md}\"",
    "test": "node --test \"tests/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "multer": "^2.0.1",
    "mysql2": "^3.11.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "prettier": "^3.4.2",
    "supertest": "^7.3.2"
  }
}
