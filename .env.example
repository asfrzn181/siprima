# ============================================================
# SiPrima - contoh environment variable
# Salin menjadi .env untuk lokal. Di cPanel isi lewat
# Setup Node.js App > Environment Variables.
# JANGAN commit file .env.
# ============================================================

# Aplikasi
NODE_ENV=production
APP_BASE_URL=https://asfrzn.web.id/siprima
# Base path bila Application URL memakai subfolder (mis. /siprima). Kosong = root.
BASE_PATH=/siprima
PORT=3000
TRUST_PROXY=1

# MySQL 8
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=siprima
DB_PASSWORD=ganti-dengan-password-kuat
DB_NAME=siprima
DB_POOL_MAX=10
DB_SSL=false

# Sesi dan keamanan
SESSION_COOKIE_NAME=siprima_session
SESSION_MAX_AGE_HOURS=8
CSRF_COOKIE_NAME=siprima_csrf
BCRYPT_ROUNDS=12
PASSWORD_RESET_TTL_MINUTES=30
# Set true hanya di lokal agar token reset dikembalikan di respons API.
AUTH_EXPOSE_RESET_TOKEN=false

# CORS: daftar origin dipisah koma. Kosong = hanya same-origin.
CORS_ORIGINS=

# API cron (Google Apps Script)
CRON_API_KEY_HEADER=x-cron-key
CRON_RUN_HISTORY_LIMIT=50
CRON_RATE_LIMIT_MAX=120

# Penyimpanan berkas
UPLOAD_DIR=./storage/scan
BACKUP_DIR=./storage/backup
MAX_UPLOAD_MB=5

# Log
LOG_DIR=./logs
LOG_FILE=siprima-error.log

# Rate limit
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10

# ============================================================
# Seeder (dipakai `npm run seed`, tidak dibaca saat runtime)
# ============================================================
ADMIN_EMAIL=admin@dinas.go.id
ADMIN_PASSWORD=ganti-password-minimal-8-karakter
ADMIN_NAMA=Administrator
# JSON array: [{"kode":"SEK","nama":"Sekretariat","aktif":true}]
SEED_BIDANG_JSON=
SEED_NAMA_DINAS=
# Kunci awal untuk Google Apps Script (plaintext hanya di sini, disimpan sebagai SHA-256)
CRON_SEED_KEY=
CRON_SEED_NAME=Google Apps Script
CRON_SEED_ALLOWED_JOBS=cleanup_expired_reservations,cleanup_orphan_uploads,export_snapshot,audit_data
