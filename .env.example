# ============================================================
# SiPrima - contoh environment variable
# Salin menjadi .env untuk lokal. Di cPanel isi lewat
# Setup Node.js App > Environment Variables.
# JANGAN commit file .env atau service account.
# ============================================================

# Wajib
NODE_ENV=production
APP_BASE_URL=https://siprima.example.com
FIREBASE_PROJECT_ID=siprima-dev
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@siprima-dev.iam.gserviceaccount.com
# Gunakan salah satu: isi private key langsung (dengan \n) atau path file di luar public_html.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_PRIVATE_KEY_PATH=/home/USER/siprima-secrets/service-account.json

# API key Web Firebase, dipakai backend untuk verifikasi email/password.
# Bukan rahasia server, tetapi tetap jangan ditampilkan di frontend.
FIREBASE_WEB_API_KEY=AIza...

# Opsional
FIREBASE_STORAGE_BUCKET=siprima-dev.firebasestorage.app
PORT=3000
TRUST_PROXY=1

# Sesi
SESSION_COOKIE_NAME=siprima_session
SESSION_MAX_AGE_HOURS=8
CSRF_COOKIE_NAME=siprima_csrf

# Unggahan (WAJIB di luar public_html)
UPLOAD_DIR=/home/USER/siprima-storage/scan
MAX_UPLOAD_MB=5

# Log
LOG_DIR=/home/USER/siprima-storage/logs
LOG_FILE=siprima-error.log

# Rate limit
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10
